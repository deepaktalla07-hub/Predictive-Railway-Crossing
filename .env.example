# =================================================================
# Railway Gate Route Assistant - Environment Configuration Template
# =================================================================

# -----------------------------------------------------------------
# 1. Backend Server Configuration
# -----------------------------------------------------------------
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info

# -----------------------------------------------------------------
# 2. Data Provider Modes
# Options for ROUTING_PROVIDER: 'DEV_STUB' | 'OSRM' | 'GOOGLE'
# Options for RAILWAY_CROSSING_PROVIDER: 'DEV_STUB' | 'OSM_OVERPASS' | 'POSTGIS'
# Options for TRAIN_SCHEDULE_PROVIDER: 'DEV_STUB' | 'LOCAL_BASELINE' | 'RAPIDAPI_LIVE'
# -----------------------------------------------------------------
ROUTING_PROVIDER=DEV_STUB
RAILWAY_CROSSING_PROVIDER=OSM_OVERPASS
TRAIN_SCHEDULE_PROVIDER=LOCAL_BASELINE

# -----------------------------------------------------------------
# 3. External API Endpoints & Backend Credentials
# -----------------------------------------------------------------
# OSRM Driving Server (Default public demo / self-hosted instance)
OSRM_BASE_URL=https://router.project-osrm.org

# OpenStreetMap Overpass API for Level Crossings & Railway Lines
OSM_OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# RapidAPI Indian Railways Live Status Credentials (Backend ONLY - Never exposed to frontend)
# Used when TRAIN_SCHEDULE_PROVIDER=RAPIDAPI_LIVE
RAPIDAPI_KEY=
RAPIDAPI_TRAIN_HOST=irctc1.p.rapidapi.com

# Backend Google Maps API Key (Optional, for backend directions)
GOOGLE_MAPS_API_KEY=

# Static GTFS or Live Rail Telemetry Feed URL (Optional)
GTFS_RT_FEED_URL=

# -----------------------------------------------------------------
# 4. Database & Cache (Optional / Production)
# -----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railway_routing
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------
# 5. Frontend Client Configuration & Mapping Providers
# -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_ENABLE_COMMUNITY_REPORTING=true

# Google Maps Platform API Key for Frontend (Optional)
# Used for: Interactive Map, Places Autocomplete, and Directions
# Security Notice: Restrict your Google API Key to HTTP Referrers (e.g. http://localhost:5173/*)
# and enable Maps JavaScript API + Places API in Google Cloud Console.
# When left empty, the application automatically falls back to OpenStreetMap & Leaflet.
VITE_GOOGLE_MAPS_API_KEY=
