{
  "name": "@railway-gate/shared",
  "version": "1.0.0",
  "description": "Shared domain models, types, and interfaces for Railway Gate Route Assistant",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.2"
  }
}
